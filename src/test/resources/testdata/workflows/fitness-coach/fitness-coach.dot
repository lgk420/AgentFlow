digraph fitness_coach {
    rankdir=TB;
    graph [fontname="Microsoft YaHei", bgcolor="white", splines=true, nodesep=0.45, ranksep=0.7];
    node  [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=10, penwidth=1.2];
    edge  [fontname="Microsoft YaHei", fontsize=9, color="#718096", arrowsize=0.8];

    start                            [label="start", shape=ellipse, fillcolor="#edf2f7", color="#4a5568"];
    llm_intent_route_node            [label="llm_intent_route_node\nLLM · 意图分流", fillcolor="#cfe8ff", color="#2b6cb0"];
    llm_training_log_parsing_node    [label="llm_training_log_parsing_node\nLLM · 解析日志（大肌群 / 小肌群 / 动作 / 组次）", fillcolor="#cfe8ff", color="#2b6cb0"];
    tool_training_log_memory_node    [label="tool_training_log_memory_node\nTOOL · 存日志 + 读回全部", fillcolor="#d4f5d4", color="#2f855a", penwidth=1.8];
    tool_training_metrics_node       [label="tool_training_metrics_node\nTOOL · 算本次指标", fillcolor="#d4f5d4", color="#2f855a"];
    llm_training_plan_node           [label="llm_training_plan_node\nLLM · 定下次：大肌群 + 小肌群", fillcolor="#cfe8ff", color="#2b6cb0", penwidth=1.8];
    rag_primary_muscle_knowledge_node [label="rag_primary_muscle_knowledge_node\nRAG · 大肌群：动作要领 + 怎么加重  top5", fillcolor="#ffe9c7", color="#c05621", penwidth=1.8];
    rag_accessory_muscle_knowledge_node [label="rag_accessory_muscle_knowledge_node\nRAG · 该大肌群的大带小规则  top1", fillcolor="#ffe9c7", color="#c05621", penwidth=1.8];
    agent_review_advice_node         [label="agent_review_advice_node\nAGENTIC_LOOP · 复盘 + 下次建议", fillcolor="#e9d8fd", color="#6b46c1", penwidth=2.0];
    tool_report_markdown_node        [label="tool_report_markdown_node\nTOOL · 报告落盘", fillcolor="#d4f5d4", color="#2f855a"];
    agent_chat_node                [label="agent_chat_node\nAGENTIC_LOOP · 聊天 / 提问（工具待补）", fillcolor="#e9d8fd", color="#6b46c1", penwidth=2.0];
    memory_conversation_node         [label="memory_conversation_node\nMEMORY_WRITE · 对话记忆", fillcolor="#fde8e8", color="#c53030"];
    end                              [label="end", shape=ellipse, fillcolor="#edf2f7", color="#4a5568"];

    { rank=same; llm_training_log_parsing_node; agent_chat_node; }
    { rank=same; tool_training_metrics_node; llm_training_plan_node; }
    { rank=same; rag_primary_muscle_knowledge_node; rag_accessory_muscle_knowledge_node; }

    start -> llm_intent_route_node;

    /* CONDITIONAL 条件路由（spEL），不再多调一次 LLM */
    llm_intent_route_node -> llm_training_log_parsing_node [label=" intent == 'LOG' ", color="#2b6cb0", fontcolor="#2b6cb0", penwidth=1.8];
    llm_intent_route_node -> agent_chat_node             [label=" intent != 'LOG'（其余一切）", color="#2b6cb0", fontcolor="#2b6cb0", penwidth=1.8];

    llm_training_log_parsing_node -> tool_training_log_memory_node [label="本次日志"];
    llm_training_log_parsing_node -> tool_training_metrics_node    [label="本次动作"];

    tool_training_log_memory_node -> tool_training_metrics_node [label="全部记录"];
    tool_training_log_memory_node -> llm_training_plan_node     [label="全部记录"];

    llm_training_plan_node -> rag_primary_muscle_knowledge_node   [label="下次大肌群", color="#c05621", fontcolor="#c05621", penwidth=1.8];
    llm_training_plan_node -> rag_accessory_muscle_knowledge_node [label="下次大肌群（查它的大带小规则）", color="#c05621", fontcolor="#c05621", penwidth=1.8];

    tool_training_metrics_node         -> agent_review_advice_node [label="本次指标"];
    llm_training_plan_node             -> agent_review_advice_node [label="下次大肌群 + 小肌群"];
    rag_primary_muscle_knowledge_node  -> agent_review_advice_node [label="大肌群知识"];
    rag_accessory_muscle_knowledge_node -> agent_review_advice_node [label="大带小规则"];

    agent_review_advice_node  -> tool_report_markdown_node [label="落盘"];
    tool_report_markdown_node -> memory_conversation_node;
    agent_chat_node         -> memory_conversation_node;
    memory_conversation_node  -> end;
}
